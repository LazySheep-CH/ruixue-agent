# 生产环境变量模板 —— 复制成 .env.prod 后填真值。
#
#   cp docker/.env.prod.example docker/.env.prod
#
# .env.prod 已在 .gitignore 里,【绝不要提交】。
# 这个 .example 文件的作用是:让人知道有哪些变量要配,而不用去翻代码。

# ── 模型服务 ──────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-填你的真实key

# 数据库凭据【不在这里配】—— 它们在 docker/.env 里,compose 会先加载 .env
# 再加载本文件。同一个密码写两份文件,迟早只改一份然后连不上。

# ── 访问控制 ──────────────────────────────────────────────────
# 程序化调用的 API Key,多个用逗号分隔,格式 key:用户名
RUIXUE_API_KEYS=
# 登录态签名密钥。必须换 —— 用默认值等于任何人都能伪造登录态。
# 生成:python -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET=
# 前端域名白名单。走 nginx 同源反代时其实用不到跨域,
# 但如果前端单独部署在别的域名下,这里必须列出来。
CORS_ORIGINS=https://你的域名

# ── 容量与配额(含义见 docs/运维手册.md「并发与容量」)──────────
UVICORN_WORKERS=2          # 每 worker 约占 30 条 PG 连接,加之前先看 max_connections
MAX_CONCURRENT_RUNS=8      # 每 worker 同时在跑的 agent 上限
MAX_QUEUED_RUNS=16         # 排队上限,超出直接 503
DAILY_CHAT_QUOTA=200       # 单用户每日对话上限

# ── 对外端口 ──────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443

# ── 镜像标签 ──────────────────────────────────────────────────
# 生产【不要用 latest】:出问题时无法确定线上到底跑的是哪个版本,也没法回滚。
# 用 git 短 sha 或语义化版本,例如 APP_TAG=v0.3.1 / APP_TAG=8f3c2d1
APP_TAG=latest
