# 复制成 .env 再改:  cp docker/.env.example docker/.env
#
# 为什么要有这个模板文件:真正的 .env 被 gitignore 挡着(里面有密码),
# 那别人 clone 下来根本不知道该配哪些变量。模板进 git,值不进 git。
# 这是【配置=代码,凭据≠代码】的标准做法。

# ── 版本 ──
# Milvus 选型记录:官方文档默认推 v3.0-beta,但 beta 不能用于要长期跑的项目。
# 查 GitHub releases 取最新【稳定版】。
MILVUS_VERSION=v2.6.20
ETCD_VERSION=v3.5.25
MINIO_VERSION=RELEASE.2024-12-18T13-15-44Z
POSTGRES_VERSION=17-alpine

# ── 对外端口(和本机其它服务冲突时改这里)──
MILVUS_PORT=19530
MILVUS_WEBUI_PORT=9091
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_PORT=5432

# ── PostgreSQL 凭据 ──
# ⚠ 本地开发用弱密码没关系(只监听 localhost);上线必须换成密钥管理服务
#   (Vault / AWS Secrets Manager / K8s Secret),不能是文件里的明文。
POSTGRES_USER=ruixue
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ruixue

# ── Redis:多 worker 的共享状态(限流计数 + 用量配额)────────────
# 【生产必配】不配则退回单进程内存:多 worker 时限额会被放大 N 倍,配额也失效。
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# 每用户每日对话次数上限。限流(20/分)管频率,这个管总量 ——
# 按 20/分老实调,一天也能 28800 次,足够烧光整月模型额度。
DAILY_CHAT_QUOTA=200
