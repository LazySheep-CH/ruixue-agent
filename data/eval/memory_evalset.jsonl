// 长期记忆收益评测集(冻结)。测的是【跨会话】记忆,不是同一会话里的上下文。
//
// 每道题两轮,分别跑在【不同 thread_id、同一 user_id】下:
//     setup 轮  thread = "<user>:s1"   用户陈述一个只有他自己知道的事实
//     probe 轮  thread = "<user>:s2"   一个必须用上那个事实才能答好的问题
//
// 换 thread 是这个评测成立的前提:同一 thread 里 checkpointer 就把上下文带过去了,
// 那测的是短期记忆。换了 thread,上下文归零,只有长期记忆能救。
//
// ⚠ 出题铁律:probe 里【绝不能】重复 setup 里的关键信息。
//   否则不需要记忆也能答对,这道题的收益恒为 0 —— 而且不会报错,只会静默地
//   把真实收益稀释掉。加载时会自动校验(见 memory_bench.py 的 _validate)。
//
// ⚠ 每道题一个独立 user_id:题与题之间不许共享记忆,否则前面的事实会污染后面的题。
//
// ── 地块与面积:最典型的"上次那块地" ────────────────────────────
{"id": "m01", "user": "memev-m01", "setup": "我在新疆尉犁县有 50 亩棉花地。", "probe": "帮我算一下要买多少地膜。", "keypoints": [{"value": 50, "tol": 0.1, "note": "必须用上 50 亩"}], "note": "没记忆时正确行为是反问面积;有记忆才能直接算"}
{"id": "m02", "user": "memev-m02", "setup": "我承包的地在甘肃张掖,一共 30 亩,种玉米。", "probe": "我这边的环境适合用全生物降解膜吗?", "keypoints": [{"pattern": "张掖|甘肃", "note": "必须认出地点"}], "note": "'我这边'完全依赖记忆才能落地"}
{"id": "m03", "user": "memev-m03", "setup": "我家地块是内蒙古赤峰的,80 亩。", "probe": "按我地块的面积算一下 0.012 毫米厚的膜要多少公斤。", "keypoints": [{"value": 80, "tol": 0.1, "note": "必须用上 80 亩"}], "note": "给了厚度但没给面积 —— 面积只能来自记忆"}
// ── 作物与周期 ──────────────────────────────────────────────────
{"id": "m04", "user": "memev-m04", "setup": "我种的是棉花,当地生育期大概 150 天。", "probe": "在尉犁县,PBAT 七成 PLA 三成的配方,到收获时降解得怎么样?", "keypoints": [{"value": 150, "tol": 1, "note": "必须用上 150 天"}], "note": "'到收获时'=生育期天数,只有记忆里有"}
{"id": "m05", "user": "memev-m05", "setup": "我这边种的是春玉米,四月中旬播种,生育期约 120 天。", "probe": "帮我在赤峰选个合适的降解膜配方。", "keypoints": [{"value": 120, "tol": 1, "note": "必须用上 120 天"}], "note": "配方筛选必须要天数,不给就得反问"}
// ── 偏好与约束:比事实更难,因为它要影响【结论方向】而不只是填个参数 ──
{"id": "m06", "user": "memev-m06", "setup": "我们那边特别干旱,我最看重的是保墒,别的可以让步。", "probe": "给我推荐一款地膜,说说理由。", "keypoints": [{"pattern": "保墒|水分|蒸发|透过率", "note": "推荐理由要落在保墒上"}], "note": "偏好要影响取舍方向,不是复述一个数"}
{"id": "m07", "user": "memev-m07", "setup": "我们这儿春天风特别大,前两年铺的膜被吹烂过好几次。", "probe": "选膜的时候我该重点看哪个指标?", "keypoints": [{"pattern": "拉伸|强度|力学|抗风", "note": "要指向拉伸强度"}], "note": "从'风大'推到'看拉伸强度',要真用上记忆"}
{"id": "m08", "user": "memev-m08", "setup": "我们公司做质检,只认国标,所有指标都要能对到标准条文。", "probe": "断裂伸长率这个指标你怎么看?", "keypoints": [{"pattern": "GB|国标|标准", "note": "要主动给标准依据"}], "note": "职业身份应改变回答的形态(给条文而非泛泛而谈)"}
// ── 组合:两个事实一起用 ─────────────────────────────────────────
{"id": "m09", "user": "memev-m09", "setup": "我在南京有 25 亩地,种蔬菜,一茬大概 90 天。", "probe": "帮我算算用量,顺便预测下这季结束时膜降解成什么样。", "keypoints": [{"value": 25, "tol": 0.1, "note": "用上面积"}, {"value": 90, "tol": 1, "note": "用上天数"}], "note": "两个事实都要用上,漏一个就答不全"}
{"id": "m10", "user": "memev-m10", "setup": "我的地在尉犁县,120 亩,种棉花,生育期 150 天。", "probe": "帮我把方案定下来:选什么膜、买多少。", "keypoints": [{"value": 120, "tol": 0.1, "note": "用上面积"}, {"pattern": "尉犁", "note": "用上地点"}], "note": "最接近真实使用:一句话让它把之前说过的全用起来"}
// ── 否定型:记住"不要什么"比记住"要什么"更容易丢 ────────────────
{"id": "m11", "user": "memev-m11", "setup": "我们不用 PE 膜,政策要求必须全生物降解的。", "probe": "帮我算 40 亩地 0.01 毫米的用量。", "keypoints": [{"pattern": "生物降解|降解膜", "note": "必须按降解膜算,不能默认 PE"}], "note": "工具默认参数是 PE —— 记忆必须能覆盖默认值,这是最容易漏的一类"}
{"id": "m12", "user": "memev-m12", "setup": "我这边不缺水,是滴灌,保墒不是我的痛点。", "probe": "选配方时哪些指标对我不那么关键?", "keypoints": [{"pattern": "保墒|透过率|水分", "note": "要认出保墒对他不关键"}], "note": "否定型偏好:要主动排除,不是罗列全部"}
